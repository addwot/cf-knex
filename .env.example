# .env.example
MYSQL_URL=mysql://root:root@127.0.0.1:3306/cf_knex_test
MARIADB_URL=mysql://root:root@127.0.0.1:3307/cf_knex_test
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/cf_knex_test
LIBSQL_URL=http://127.0.0.1:8080
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_MYSQL=mysql://root:root@127.0.0.1:3306/cf_knex_test
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_PG=postgres://postgres:postgres@127.0.0.1:5432/cf_knex_test

# The hosted tiers. Everything above points at docker-compose.yml and has
# working values; these four are real accounts, so they are templates. Leave
# them unset and the suites gated on them register a named `test.skip`
# placeholder rather than failing -- `pnpm test` stays green without them. In
# CI they come from repository secrets, and the `live` job asserts they were
# actually used rather than silently skipped.
#
# Put real values in `.env`, never here: this file is committed, and gitleaks
# scans the whole history on every PR. (`.gitignore` covers `.env*` and admits
# only this one file back.)
# TIDB_URL=mysql://<user>:<password>@<host>.tidbcloud.com:4000/<database>
# NEON_URL=postgres://<user>:<password>@<host>.neon.tech/<database>?sslmode=require
# TURSO_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=<jwt from `turso db tokens create <database>`>
